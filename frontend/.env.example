# Copy this file to .env.local and fill it in.
# .env.local is ignored by git, so nothing here reaches GitHub.

# Where the backend is running. The default matches backend/.env.
VITE_API_URL=http://localhost:4000

# Only needed once you set up "Continue with Google". See SETUP.md.
# This is the same client id the backend uses. It is not a secret.
VITE_GOOGLE_CLIENT_ID=
