# Copy this file to .env and fill it in.
# .env is ignored by git, so real secrets never reach GitHub.

# Where the server listens.
PORT=4000

# The address the React app is served from. The browser will refuse to send
# cookies to this API unless this matches exactly, including the port.
CLIENT_ORIGIN=http://localhost:5173

# Needed only for "Continue with Google". Leave blank until you have one,
# and the Google button will return a clear error instead of half working.
# This is the SAME client id the frontend uses. It is not a secret.
GOOGLE_CLIENT_ID=
