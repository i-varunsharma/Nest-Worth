# Copy this file to .env and fill it in:
#
#     cp .env.example .env
#
# .env is ignored by git, so real secrets never reach GitHub. This file is
# committed, because it is only a blank template, and it doubles as the list of
# every setting the server understands.
#
# Nothing below is required to run the app locally. Every setting has a sensible
# default, and the app works without a .env file at all.


# ---------------------------------------------------------------
# The basics
# ---------------------------------------------------------------

# Which port the API listens on.
PORT=4000

# The address the React app is served from. The browser will refuse to send
# cookies to this API unless this matches exactly, including the port.
#
# When you deploy, change this to your real domain, or people will silently
# fail to stay signed in. It is also the address used to build password reset
# links, so a wrong value here sends people to a link that does not exist.
CLIENT_ORIGIN=http://localhost:5173

# Set this to "production" when you deploy. It is what switches the session
# cookie to "secure", meaning it is only ever sent over HTTPS.
# NODE_ENV=production


# ---------------------------------------------------------------
# Continue with Google
# ---------------------------------------------------------------

# Needed only for "Continue with Google". Leave it blank until you have one and
# the Google button will explain itself instead of half working.
#
# This is the SAME client id the frontend uses, and it is not a secret. The
# client SECRET is a secret, is not needed for this flow, and must never appear
# in frontend/. See SETUP.md.
GOOGLE_CLIENT_ID=


# ---------------------------------------------------------------
# The AI coach
# ---------------------------------------------------------------

# The coach works with either of two models. Set ONE of the keys below.
#
# Whichever key is present is the one used. With both, Gemini wins, because it
# is the free one. AI_PROVIDER=claude or AI_PROVIDER=gemini overrides that.
#
# These are real secrets, unlike GOOGLE_CLIENT_ID above. They stay on the
# server. A key in frontend code is a key anybody can read in their browser and
# spend your money with.


# --- Gemini: has a free allowance, which is why it is the default ---
#
# Get one at  https://aistudio.google.com/apikey
# Sign in with a Google account, press "Create API key", copy it, paste it here.
GEMINI_API_KEY=

# Google renames its models fairly often. If the coach says there is no such
# model, pick a current one from ai.google.dev/models and name it here.
# GEMINI_MODEL=gemini-2.0-flash


# --- Claude: paid, no free tier. Get one at console.anthropic.com ---
ANTHROPIC_API_KEY=

# ANTHROPIC_MODEL=claude-opus-5


# Force one provider when both keys are set. "gemini" or "claude".
# AI_PROVIDER=


# ---------------------------------------------------------------
# Settings you will probably never touch
# ---------------------------------------------------------------

# Where the SQLite file lives. Defaults to backend/data/nestworth.db.
# The tests set this themselves, to a throwaway file in a temporary folder, so
# that running them can never damage the database you have been building with.
# NESTWORTH_DB_FILE=

# Turns off the rate limiting on sign-in, sign-up and code sending.
#
# This exists for the test suite, which makes dozens of accounts in a couple of
# seconds from one address and would otherwise be refused. NEVER set this on a
# deployed server: it is the only thing stopping somebody guessing passwords as
# fast as the network allows.
# DISABLE_RATE_LIMIT=true
